            <form
                class="wander-search mx-lg-auto"
                action="/listings"
                method="GET">

                <div class="search-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <input
                    type="text"
                    name="q"
                    placeholder="Search destinations..."
                    autocomplete="off">

                <button type="submit">
