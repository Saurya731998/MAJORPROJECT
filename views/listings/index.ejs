<% layout("/layouts/boilerplate") %>

<!-- ================= HERO SECTION ================= -->

<section class="wander-hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <span class="hero-badge">
            <i class="fa-solid fa-location-dot"></i>
            Explore the world
        </span>

        <h1>
            Find your next
            <span>adventure.</span>
        </h1>

        <p>
            Discover beautiful stays, unique places and unforgettable
            experiences around the world.
        </p>

        <a href="#exploreListings" class="hero-btn">
            Explore stays
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </div>

</section>


<!-- ================= CATEGORY FILTER ================= -->

<section class="category-section">

    <div class="category-header">

        <div>
            <span class="section-small-title">
                DISCOVER
            </span>

            <h2>
                Explore by category
            </h2>
        </div>

        <div class="tax-toggle modern-tax-toggle">

            <div class="form-check form-switch">

                <input
                    class="form-check-input"
                    type="checkbox"
                    role="switch"
                    id="switchCheckDefault">

                <label
                    class="form-check-label"
                    for="switchCheckDefault">

                    Display total after taxes

                </label>

            </div>

        </div>

    </div>


    <div class="category-wrapper">

        <button
            type="button"
            class="category-arrow"
            id="filters-prev"
            aria-label="Previous categories">

            <i class="fa-solid fa-chevron-left"></i>

        </button>


        <div id="filters">

            <!-- ALL -->

            <a
                href="/listings"
                class="category-item <%= !activeCategory ? 'active' : '' %>">

                <div class="category-icon">
                    <i class="fa-solid fa-border-all"></i>
                </div>

                <span>All</span>

            </a>


            <!-- DYNAMIC CATEGORIES -->

            <% for (let c of categories) { %>

                <a
                    href="/listings?category=<%= c.key %>"
                    class="category-item <%= activeCategory === c.key ? 'active' : '' %>">

                    <div class="category-icon">

                        <i class="<%= c.icon %>"></i>

                    </div>

                    <span>
                        <%= c.label %>
                    </span>

                </a>

            <% } %>

        </div>


        <button
            type="button"
            class="category-arrow"
            id="filters-next"
            aria-label="Next categories">

            <i class="fa-solid fa-chevron-right"></i>

        </button>

    </div>

</section>



<!-- ================= LISTINGS ================= -->

<section
    class="listings-section"
    id="exploreListings">

    <div class="listings-heading">

        <div>

            <span class="section-small-title">
                WANDERLUST COLLECTION
            </span>

            <h2>
                Popular stays
            </h2>

        </div>

        <span class="listing-count">
            <%= allListings.length %> places
        </span>

    </div>


    <% if (allListings.length > 0) { %>

        <div class="listing-grid">

            <% for (let listing of allListings) { %>

                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link">

                    <article class="modern-listing-card">

                        <!-- IMAGE -->

                        <div class="listing-image-wrapper">

                            <img
                                src="<%= listing.image.url %>"
                                alt="<%= listing.title %>"
                                class="listing-image">

                            <div class="image-gradient"></div>

                            <span class="guest-favorite">
                                <i class="fa-solid fa-heart"></i>
                            </span>

                            <span class="view-details">
                                View details
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>


                        <!-- CONTENT -->

                        <div class="modern-card-content">

                            <div class="listing-title-row">

                                <h3>
                                    <%= listing.title %>
                                </h3>

                                <span class="listing-rating">
                                    <i class="fa-solid fa-star"></i>
                                    4.8
                                </span>

                            </div>


                            <p class="listing-location">

                                <i class="fa-solid fa-location-dot"></i>

                                <%= listing.location %>
                                <% if(listing.country) { %>
                                    , <%= listing.country %>
                                <% } %>

                            </p>


                            <div class="listing-price">

                                <strong>
                                    ₹<%= listing.price.toLocaleString("en-IN") %>
                                </strong>

                                <span>
                                    / night
                                </span>

                                <span class="tax-info">
                                    +18% GST
                                </span>

                            </div>

                        </div>

                    </article>

                </a>

            <% } %>

        </div>

    <% } else { %>

        <!-- EMPTY STATE -->

        <div class="empty-listings">

            <div class="empty-icon">
                <i class="fa-solid fa-map-location-dot"></i>
            </div>

            <h3>
                No stays found
            </h3>

            <p>
                There are no listings in this category right now.
            </p>

            <a href="/listings" class="empty-btn">
                View all stays
            </a>

        </div>

    <% } %>

</section>



<!-- ================= WHY WANDERLUST ================= -->

<section class="why-section">

    <div class="why-heading">

        <span class="section-small-title">
            WHY WANDERLUST
        </span>

        <h2>
            Travel better. Explore more.
        </h2>

    </div>


    <div class="why-grid">

        <div class="why-card">

            <div class="why-icon">
                <i class="fa-solid fa-earth-americas"></i>
            </div>

            <h3>
                Amazing destinations
            </h3>

            <p>
                Discover beautiful places and unique stays
                from different parts of the world.
            </p>

        </div>


        <div class="why-card">

            <div class="why-icon">
                <i class="fa-solid fa-shield-heart"></i>
            </div>

            <h3>
                Trusted stays
            </h3>

            <p>
                Find comfortable properties designed to make
                your journey memorable.
            </p>

        </div>


        <div class="why-card">

            <div class="why-icon">
                <i class="fa-solid fa-route"></i>
            </div>

            <h3>
                Travel your way
            </h3>

            <p>
                Choose the perfect stay for your next adventure
                and create your own experience.
            </p>

        </div>

    </div>

</section>



<!-- ================= TAX + CATEGORY JS ================= -->

<script>

    /* TAX TOGGLE */

    const taxSwitch =
        document.getElementById("switchCheckDefault");

    if (taxSwitch) {

        taxSwitch.addEventListener("change", function () {

            const taxInfo =
                document.querySelectorAll(".tax-info");

            taxInfo.forEach(function(info) {

                info.classList.toggle(
                    "show-tax",
                    taxSwitch.checked
                );

            });

        });

    }



    /* CATEGORY SCROLL */

    const filters =
        document.getElementById("filters");

    const previousButton =
        document.getElementById("filters-prev");

    const nextButton =
        document.getElementById("filters-next");


    if (filters && previousButton && nextButton) {

        previousButton.addEventListener("click", function () {

            filters.scrollBy({
                left: -350,
                behavior: "smooth"
            });

        });


        nextButton.addEventListener("click", function () {

            filters.scrollBy({
                left: 350,
                behavior: "smooth"
            });

        });

    }



    /* SCROLL TO LISTINGS */

    document.querySelectorAll(
        'a[href="#exploreListings"]'
    ).forEach(function(link) {

        link.addEventListener("click", function(e) {

            e.preventDefault();

            document
                .getElementById("exploreListings")
                .scrollIntoView({
                    behavior: "smooth"
                });

        });

    });

</script>